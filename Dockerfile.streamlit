
FROM python:3.14-slim

WORKDIR /app

COPY requirements-streamlit.txt .

RUN pip install --no-cache-dir --index-url https://pypi.org/simple -r requirements-streamlit.txt

COPY notebooks/ ./notebooks/
COPY models/ ./models/
COPY dataset/ ./dataset/

EXPOSE 8501

CMD ["streamlit", "run", "notebooks/07_web_app.py", "--server.address=0.0.0.0", "--server.port=8501"]
